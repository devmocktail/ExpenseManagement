{
  "ConnectionStrings": {
    "//": "Set per environment. Never commit a real connection string with credentials.",
    "DefaultConnection": ""
  },

  "Jwt": {
    "//": "Secret is intentionally empty here. Supply it via user-secrets in development or an environment variable (Jwt__Secret) elsewhere. Startup fails fast if it is missing or shorter than 32 characters.",
    "Secret": "",
    "Issuer": "ExpenseManagement.Api",
    "Audience": "ExpenseManagement.Mobile",
    "AccessTokenMinutes": 15,
    "RefreshTokenDays": 30
  },

  "FileStorage": {
    "//": "Must resolve OUTSIDE wwwroot. Receipts are served through an authorizing endpoint, never as static files.",
    "RootPath": "storage",
    "MaxFileSizeBytes": 10485760
  },

  "Cors": {
    "//": "Empty in the base file. A native app sends no Origin header so it needs no entry here; this exists for a future web dashboard.",
    "AllowedOrigins": []
  },

  "RateLimiting": {
    "AuthPermitPerMinute": 10,
    "GlobalPermitPerMinute": 300
  },

  "Seed": {
    "DemoUser": false,
    "DemoPassword": ""
  },

  "Serilog": {
    "MinimumLevel": {
      "Default": "Information",
      "Override": {
        "Microsoft.AspNetCore": "Warning",
        "Microsoft.EntityFrameworkCore.Database.Command": "Warning",
        "System.Net.Http.HttpClient": "Warning"
      }
    },
    "Enrich": [ "FromLogContext", "WithMachineName", "WithThreadId" ],
    "WriteTo": [
      {
        "Name": "Console",
        "Args": {
          "outputTemplate": "[{Timestamp:HH:mm:ss} {Level:u3}] {Message:lj} {Properties:j}{NewLine}{Exception}"
        }
      },
      {
        "Name": "File",
        "Args": {
          "path": "logs/expense-.log",
          "rollingInterval": "Day",
          "retainedFileCountLimit": 14,
          "outputTemplate": "{Timestamp:o} [{Level:u3}] ({SourceContext}) {Message:lj}{NewLine}{Exception}"
        }
      }
    ]
  },

  "AllowedHosts": "*"
}
