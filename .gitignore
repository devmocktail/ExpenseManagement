!.env.*.example
# Tracked deliberately: it contains only local endpoints, so a fresh clone runs
# with no setup. Verified to hold no secrets - keep it that way.
!mobile/.env.development
appsettings.Local.json
appsettings.*.Local.json
secrets.json
*.pfx
*.p12
*.keystore
*.jks
