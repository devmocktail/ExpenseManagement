# Copy to .env.development / .env.staging / .env.production and fill in.
# Expo INLINES every EXPO_PUBLIC_* value into the JS bundle at build time, so
# anyone with the .apk/.ipa can read them. Endpoints and feature flags belong
# here; secrets never do.

# Where the API lives. NO trailing slash, and NO /api/v1 - the client appends it.
#   Android emulator -> http://10.0.2.2:5165   (10.0.2.2 is the emulator's alias
#                                               for the host's loopback)
#   iOS simulator    -> http://localhost:5165  (shares the host network stack)
#   Web              -> http://localhost:5165
#   Physical device  -> http://<your-LAN-IP>:5165  (localhost is the phone itself)
EXPO_PUBLIC_API_BASE_URL=http://10.0.2.2:5165

# development | staging | production
EXPO_PUBLIC_ENV=development

EXPO_PUBLIC_API_TIMEOUT_MS=20000

# Fallback only, until the signed-in user's own setting arrives from the server.
EXPO_PUBLIC_DEFAULT_CURRENCY=INR

EXPO_PUBLIC_ENABLE_DEV_TOOLS=true

# Optional crash reporting.
EXPO_PUBLIC_SENTRY_DSN=
