# Local development. Committed on purpose: it holds no secrets and it means a
# fresh clone runs without setup.
#
# The default targets the ANDROID EMULATOR. Change the host for your target:
#   iOS simulator / web -> http://localhost:5165
#   physical device     -> http://<your-LAN-IP>:5165
EXPO_PUBLIC_API_BASE_URL=http://10.0.2.2:5165
EXPO_PUBLIC_ENV=development
EXPO_PUBLIC_API_TIMEOUT_MS=20000
EXPO_PUBLIC_DEFAULT_CURRENCY=INR
EXPO_PUBLIC_ENABLE_DEV_TOOLS=true
